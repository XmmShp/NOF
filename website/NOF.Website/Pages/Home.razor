builder.<span class="code-method">AddApplicationPart</span>(
    <span class="code-keyword">typeof</span>(OrderService).Assembly);

builder.<span class="code-method">UseDbContext</span>&lt;OrdersDbContext&gt;()
    .<span class="code-method">WithTenantMode</span>(TenantMode.DatabasePerTenant)
